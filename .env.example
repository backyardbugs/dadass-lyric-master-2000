# The Emo Almanac — copy to .env and fill in your keys

# Spotify (get from https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
# Redirect URI for "Log in with Spotify" — must match the URI added in your Spotify app settings
SPOTIFY_REDIRECT_URI=https://your-backend.onrender.com/api/auth/spotify/callback
# Where to send users after login (your frontend URL)
FRONTEND_URL=https://frontend-woad-xi-34.vercel.app

# Genius (get from https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=your_genius_access_token
