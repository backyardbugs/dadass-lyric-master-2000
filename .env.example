# Dad Ass Lyric Analyzer 3000 — copy to .env and fill in your keys

# Spotify (get from https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
# Redirect URI for Spotify OAuth (frontend callback URL)
SPOTIFY_REDIRECT_URI=https://frontend-woad-xi-34.vercel.app/api/auth/spotify/callback
# Where to send users after login (your frontend URL)
FRONTEND_URL=https://frontend-woad-xi-34.vercel.app
# Comma-separated origins allowed to call this API from the browser
CORS_ORIGINS=https://frontend-woad-xi-34.vercel.app

# Genius (get from https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=your_genius_access_token

# Gemini craft pass (runs once per Analyze on the full lyric corpus)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Set to 0 to disable without removing the key
# GEMINI_ENABLED=1
